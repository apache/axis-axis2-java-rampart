<wsp:Policy wsu:Id="OptionalUTOverTransport" xmlns:wsu="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd" xmlns:wsp="http://schemas.xmlsoap.org/ws/2004/09/policy">
<wsp:ExactlyOne>
  <wsp:All>
	<sp:TransportBinding xmlns:sp="http://schemas.xmlsoap.org/ws/2005/07/securitypolicy">
	  <wsp:Policy>
		<sp:TransportToken>
		  <wsp:Policy>
		  </wsp:Policy>
		</sp:TransportToken>
		<sp:AlgorithmSuite>
		  <wsp:Policy>
			<sp:Basic128/>
		  </wsp:Policy>
		</sp:AlgorithmSuite>
		<sp:Layout>
		  <wsp:Policy>
			<sp:Lax/>
		  </wsp:Policy>
		</sp:Layout>
		<sp:IncludeTimestamp/>
	  </wsp:Policy>
	</sp:TransportBinding>
	<!-- RAMPART-286: the UsernameToken is optional and the client configures no
	     user, so the client must send no token and the service must accept that. -->
	<sp:SignedSupportingTokens xmlns:sp="http://schemas.xmlsoap.org/ws/2005/07/securitypolicy">
		<wsp:Policy>
			<sp:UsernameToken wsp:Optional="true" sp:IncludeToken="http://schemas.xmlsoap.org/ws/2005/07/securitypolicy/IncludeToken/AlwaysToRecipient" />
	  </wsp:Policy>
	</sp:SignedSupportingTokens>

	<ramp:RampartConfig xmlns:ramp="http://ws.apache.org/rampart/policy">
		<ramp:passwordCallbackClass>org.apache.rampart.PWCallback</ramp:passwordCallbackClass>
	</ramp:RampartConfig>
  </wsp:All>
</wsp:ExactlyOne>
</wsp:Policy>
